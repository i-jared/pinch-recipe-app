# Generate a random key: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Give it to people allowed to create an account. Empty disables registration.
PINCH_REGISTRATION_KEY=
PINCH_USER_QUOTA_MB=1024
# For the optional HTTPS profile: a DNS name pointing to this machine.
PINCH_DOMAIN=recipes.example.com

# Optional managed hosting. Set both values to enable public signup and server-side AI.
PINCH_MANAGED_URL=
PINCH_MANAGED_OPENROUTER_KEY=
PINCH_MANAGED_MODEL=deepseek/deepseek-v4.1-flash
PINCH_MANAGED_AI_PER_ACCOUNT=30
PINCH_MANAGED_AI_PER_DAY=300

# Enable the ChatGPT/Codex plugin on this origin; empty keeps it disabled.
PINCH_PUBLIC_URL=
# Optional exact OAuth callbacks for other clients/local testing, comma-separated.
# ChatGPT's stable and per-connection HTTPS callbacks are allowed automatically.
PINCH_OAUTH_REDIRECT_URIS=
# Exact domain-verification token from the OpenAI plugin submission portal.
PINCH_OPENAI_CHALLENGE=

# Optional reverse-proxy prefix for the mobile API, e.g. /recipes.
# The proxy must strip it. Leave empty when using the OAuth plugin.
PINCH_ROOT_PATH=

# Exact IP(s) of the proxy as seen by Uvicorn, comma-separated. No wildcard/subnets.
# Host Caddy through Docker's loopback port: use the Pinch network's gateway IP.
# The optional container Caddy profile: use that Caddy container's IP.
# Empty trusts no forwarded headers; configure this before public deployment.
PINCH_TRUSTED_PROXY_IPS=
# Applies to the single API worker; reject excess uploads immediately with 503.
PINCH_MAX_UPLOADS=2
PINCH_UPLOAD_IDLE_SECONDS=15
PINCH_UPLOAD_TOTAL_SECONDS=180
