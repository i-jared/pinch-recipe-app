// Shared build settings for Pinch.
// Put personal values (bundle ID, signing team, Google client ID) in Local.xcconfig,
// which is git-ignored. See Local.xcconfig.example.

PINCH_BUNDLE_ID = com.example.pinch
PINCH_DEVELOPMENT_TEAM =

// OAuth client ID of type "iOS" from Google Cloud Console, e.g.
// 1234567890-abc123.apps.googleusercontent.com. Leave empty to build without Google Drive.
GOOGLE_IOS_CLIENT_ID =

#include? "Local.xcconfig"
