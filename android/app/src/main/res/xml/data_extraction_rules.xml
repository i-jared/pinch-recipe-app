<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The OpenRouter key is encrypted with a Keystore key that can't be
     backed up or moved, so its file stays behind too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
